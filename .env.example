# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis maison (12 caractères au moins, gardé dans Enpass)
MAISON_PASSWORD=change-moi-12-caracteres-minimum

# Jeton commun des échanges entre applis maison (l'Anneau lit la sauvegarde des réglages). Vide : porte fermée.
MAISON_JETON=

# Clé de lecture de l'Anneau (0.10.0) : n'ouvre que les fiches « Connexion » (/api/maison/services). Vide : l'Anneau ne les lit pas.
ANNEAU_CLE=

# Dossier du NAS pour l'état du socle
SOCLE_DATA_DIR=/volume1/docker/socle

# Facultatif
# PORT_SOCLE=8090
# SOCLE_VERSION=0.10.0

# « oui » : aucune appli maison n'écrit hors de chez elle (premier jour d'une nouvelle version)
MAISON_LECTURE_SEULE=
# Forçage pour le socle seul : « oui » ou « non » l'emporte sur MAISON_LECTURE_SEULE
APP_LECTURE_SEULE=

# Les réglages d'usage ne sont plus ici : écran Réglages de l'appli (0.6.0).
