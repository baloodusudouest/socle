# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins, gardé dans Enpass)
APPS_PASSWORD=change-moi-12-caracteres-minimum

# Dossier du NAS pour l'état du socle
SOCLE_DATA_DIR=/volume1/docker/socle

# Facultatif
# PORT_SOCLE=8090
# SOCLE_VERSION=0.1.0

# « oui » : l'appli lit tout mais n'écrit nulle part (premier jour d'une nouvelle version)
APP_LECTURE_SEULE=
